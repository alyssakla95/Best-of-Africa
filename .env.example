# ═══════════════════════════════════════════════════════════════════════════════
# Best of Africa — Environment Variables
# Copy this file to .dev.vars for local Wrangler development.
# Production secrets are set via: wrangler secret put <KEY>
# ═══════════════════════════════════════════════════════════════════════════════

# ── Required ──────────────────────────────────────────────────────────────────

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=

# Admin API key for protected admin endpoints
ADMIN_API_KEY=

# NewsAPI.org key for RSS/news ingestion (https://newsapi.org)
NEWS_API_KEY=

# ── Optional AI Providers ─────────────────────────────────────────────────────
# If not set, the platform falls back to Cloudflare Workers AI automatically.
# These can also be configured at runtime via /api/v1/agent/providers.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
MOONSHOT_CLIENT_ID=      # OAuth app client ID — platform.moonshot.cn → OAuth Apps
MOONSHOT_CLIENT_SECRET=  # OAuth app client secret
MOONSHOT_API_KEY=        # fallback only — OAuth is preferred when CLIENT_ID/SECRET are set

# ── Optional Integrations ─────────────────────────────────────────────────────

# Ko-fi webhook verification token (https://ko-fi.com/manage/webhooks)
# If omitted, the Ko-fi membership webhook will be disabled.
KOFI_TOKEN=

# ElevenLabs API key for AI audio briefings (https://elevenlabs.io)
ELEVENLABS_API_KEY=
# ElevenLabs voice ID — defaults to Rachel (21m00Tcm4TlvDq8ikWAM) if unset
ELEVENLABS_VOICE_ID=

# ── Local Dev Only ────────────────────────────────────────────────────────────

# Protects /dev/* endpoints (generate random value for production)
DEV_SECRET=

# Extra CORS origins beyond bestofafrica.com — add your local frontend URLs here
ADDITIONAL_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Runtime ───────────────────────────────────────────────────────────────────
# Set ENVIRONMENT=development in .dev.vars only — wrangler.toml defaults to production

ENVIRONMENT=development
API_VERSION=v1
