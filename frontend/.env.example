# ── Required ──────────────────────────────────────────────────────────────────
# Full URL of the deployed Cloudflare Worker API (no trailing slash).
# Production value is set in .env.production — override here for local dev.
VITE_API_URL=http://localhost:8787/api/v1
# Canonical reader-facing origin used in social metadata.
VITE_SITE_URL=http://localhost:5173
